GEMINI_API_KEY=your_api_key_here
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Encrypts saved connection strings. Generate once, never change it
# (changing it makes every saved connection unreadable):
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SCHEMAROVER_SECRET_KEY=change_me

# Required to sign up. Leave empty only for a private local setup.
SCHEMAROVER_SIGNUP_CODE=change_me
# Local dev only: lets users connect to localhost / private-network databases.
# Keep false on a public server.
SCHEMAROVER_ALLOW_PRIVATE_HOSTS=false
